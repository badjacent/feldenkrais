{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassAResult",
  "description": "Pass A output: VL Classification + SPIFFER-Q Decomposition",
  "type": "object",
  "properties": {
    "lesson_title": {
      "type": "string",
      "description": "Inferred title of the lesson"
    },
    "classifications": {
      "type": "object",
      "description": "Weighted scores (0.0-1.0) for each active VL framework (populated dynamically from frameworks.json)"
    },
    "primary_framework": {
      "type": "string",
      "description": "Primary VL framework (populated dynamically from frameworks.json)"
    },
    "secondary_frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "description": "Brief explanation of the classification"
    },
    "home_position": {
      "type": "string",
      "description": "The base configuration the student returns to between movements (e.g., 'Lying on back, knees bent, feet standing')"
    },
    "steps": {
      "type": "array",
      "description": "SPIFFER-Q decomposed lesson steps",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "integer"
          },
          "instruction": {
            "type": "string",
            "description": "The movement or instruction"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "SPIFFER-Q tags: S, P, I, F, E, R, Q"
          },
          "note": {
            "type": "string",
            "description": "Brief pedagogical note (optional)"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Segment IDs from the source text that this step covers"
          },
          "is_home": {
            "type": "boolean",
            "description": "True if this step is a return to the home position"
          }
        },
        "required": ["step_number", "instruction", "tags", "segments"]
      }
    }
  },
  "required": ["classifications", "primary_framework", "rationale", "home_position", "steps"]
}
