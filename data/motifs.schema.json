{
  "type": "object",
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "motif_id": { "type": "string" },
          "mode": { "type": "string", "enum": ["taught", "referenced"] },
          "role": { "type": "string", "enum": ["central", "supporting", "incidental"] },
          "certainty": { "type": "string", "enum": ["clear", "probable", "uncertain"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "step_ids": { "type": "array", "items": { "type": "integer" } },
                "reason": { "type": "string" }
              },
              "required": ["step_ids", "reason"]
            }
          }
        },
        "required": ["motif_id", "mode", "role", "certainty", "evidence"]
      }
    },
    "candidate_motifs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "candidate_label": { "type": "string" },
          "description": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "step_ids": { "type": "array", "items": { "type": "integer" } },
                "reason": { "type": "string" }
              },
              "required": ["step_ids"]
            }
          },
          "nearest_existing_motifs": { "type": "array", "items": { "type": "string" } },
          "why_distinct": { "type": "string" }
        },
        "required": ["candidate_label", "description", "evidence", "nearest_existing_motifs", "why_distinct"]
      }
    }
  },
  "required": ["assignments", "candidate_motifs"]
}
