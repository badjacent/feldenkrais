{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassBResult",
  "description": "Pass B output: VL Framework Synthesis (Negotiation Analysis)",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": ["VL-1", "VL-2", "VL-3", "VL-4", "VL-5"],
      "description": "The VL framework used for this analysis"
    },
    "negotiation_framework": {
      "type": "object",
      "description": "Observations about the Shadow/Foundation negotiation",
      "properties": {
        "shadow_observations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "How the Postural Effort System manifests"
        },
        "foundation_observations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "How the Postural Support System emerges"
        },
        "washing_gradient": {
          "type": "string",
          "description": "How the Shadow is eroded through the lesson"
        }
      },
      "required": ["shadow_observations", "foundation_observations", "washing_gradient"]
    },
    "somatic_narrative": {
      "type": "object",
      "description": "The arc of the lesson through this VL lens",
      "properties": {
        "primary_inquiry": {
          "type": "string",
          "description": "The fundamental riddle in this framework's terms"
        },
        "washing_gradient": {
          "type": "string",
          "description": "How cortical noise is reduced"
        },
        "threshold_of_quiet": {
          "type": "string",
          "description": "The moment where Transmission emerges"
        }
      },
      "required": ["primary_inquiry", "washing_gradient", "threshold_of_quiet"]
    },
    "analytical_table": {
      "type": "object",
      "description": "The VL Analytical Table",
      "properties": {
        "column_headers": {
          "type": "object",
          "properties": {
            "column1": {"type": "string"},
            "column2": {"type": "string"},
            "column3": {"type": "string"},
            "column4": {"type": "string"},
            "column5": {"type": "string"}
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column1": {"type": "string"},
              "column2": {"type": "string"},
              "column3": {"type": "string"},
              "column4": {"type": "string"},
              "column5": {"type": "string"},
              "vl_voice": {
                "type": "string",
                "description": "First-person experience from the VL Person Inside at this point in the lesson"
              },
              "shadow_voice": {
                "type": "string",
                "description": "What the Shadow shadow is doing or experiencing at this point"
              }
            },
            "required": ["column1", "column2", "column3", "column4", "column5", "vl_voice", "shadow_voice"]
          }
        }
      },
      "required": ["column_headers", "rows"]
    }
  },
  "required": ["framework", "negotiation_framework", "somatic_narrative", "analytical_table"]
}
