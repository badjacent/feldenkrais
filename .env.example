# Local PostgreSQL with pgvector; compose.yaml supplies this disposable database.
DATABASE_URL=postgresql://analyzer:local-example-only@127.0.0.1:55432/analyzer
KB_ENV=dev
KB_BUCKET=example-analyzer-bucket
# Set a random session signing value for any non-local deployment.
# COOKIE_SECRET=replace-with-a-random-value
# Optional provider credentials, only needed for live generation:
# GOOGLE_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GROQ_API_KEY=replace-me
# Optional trusted deployment configuration:
# KB_RESOURCE_DIRS=/absolute/path/to/resources
# KB_WEB_EXTENSIONS=example_component:register
# KB_DATABASE_MIXINS=example_component:DatabaseMixin
