# Knowledge Base Configuration
# Copy this to .env and fill in your values

# AWS
KB_BUCKET=feldenkrais-dev
KB_ENV=dev

# Database mode: "local" or "s3"
# - local: use local SQLite file directly (faster for development)
# - s3: sync DB to/from S3 (production behavior)
KB_DB_MODE=local
KB_DB_PATH=./knowledge.db

# Temp directory for Lambda (/tmp) or local development
TEMP_DIR=./tmp

# Grace period in seconds (5 minutes default)
KB_GRACE_PERIOD=300

# Groq API (for TTS - not used yet)
# GROQ_API_KEY=your-api-key-here
