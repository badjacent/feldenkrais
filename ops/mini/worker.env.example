# Durable services
DATABASE_URL=
KB_BUCKET=feldenkrais-prod
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analysis providers used by the configured pipeline
# Fail closed. Set to 1 only for an owner-approved analysis run after the
# documented dry-run and one-step smoke test.
ANALYSIS_ENABLED=0
# Optional machine-local full-analysis provider. Omit for Gemini (the default).
# codex-astra uses this machine's existing `codex login` OAuth session.
# ANALYSIS_LLM_PROVIDER=codex-astra
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local transcription
LOCAL_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
ATLAS_REPO_PATH=/Users/hermes/src/feldenkrais-index
TRANSCRIPTION_BATCH_LIMIT=20
TRANSCRIPTION_MAX_SECONDS=3300
TRANSCRIPTION_MAX_RETRIES=3
TRANSCRIPTION_STALE_MINUTES=360

# Conservative Mini worker defaults
ATLAS_CATALOG_PATH=/Users/hermes/src/feldenkrais-index/catalog/resources.json
ATLAS_INTAKE_BATCH_LIMIT=20
YOUTUBE_INGEST_BATCH_LIMIT=5
# Private cookie jar exported from the Mini's browser; never commit its contents.
YOUTUBE_COOKIES_PATH=/Users/hermes/.config/feldenkrais/youtube-cookies.txt
YOUTUBE_PLAYER_CLIENT=web_safari
# Safari currently exposes HLS as combined A/V; choose the smallest stream and
# discard video during the existing MP3 extraction step.
YOUTUBE_AUDIO_FORMAT=worst[protocol^=m3u8][acodec!=none]/bestaudio/best
ANALYSIS_MAX_STEPS=100
ANALYSIS_MAX_SECONDS=3300
ANALYSIS_WORKERS=2
ANALYSIS_STEP_TIMEOUT=600
