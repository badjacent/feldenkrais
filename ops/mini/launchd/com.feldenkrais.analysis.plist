<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.feldenkrais.analysis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hermes/ops/run-analysis-worker.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/hermes/src/feldenkrais-analysis</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANALYSIS_ROOT</key>
    <string>/Users/hermes/src/feldenkrais-analysis</string>
    <!-- Machine-level kill switch. Per-model switches live in the analysis page. -->
    <key>ANALYSIS_ENABLED</key>
    <string>1</string>
    <key>ANALYSIS_MAX_STEPS</key>
    <string>500</string>
    <key>ANALYSIS_STEP_TIMEOUT</key>
    <string>1800</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- A run drains what is runnable and exits; launchd starts the next one up to
       five minutes later, so newly switched-on work begins within minutes. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/hermes/src/feldenkrais-analysis/var/log/analysis-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hermes/src/feldenkrais-analysis/var/log/analysis-worker.log</string>
</dict>
</plist>
