{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassBTableResult",
  "description": "Pass B analytical table output (receives narrative analysis as context)",
  "type": "object",
  "properties": {
    "analytical_table": {
      "type": "object",
      "description": "The VL Analytical Table",
      "properties": {
        "column_headers": {
          "type": "object",
          "properties": {
            "column1": {"type": "string"},
            "column2": {"type": "string"},
            "column3": {"type": "string"},
            "column4": {"type": "string"},
            "column5": {"type": "string"}
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "column1": {"type": "string"},
              "column2": {"type": "string"},
              "column3": {"type": "string"},
              "column4": {"type": "string"},
              "column5": {"type": "string"},
              "vl_voice": {
                "type": "string",
                "description": "First-person experience from the VL Person Inside at this point in the lesson"
              },
              "shadow_voice": {
                "type": "string",
                "description": "What the Shadow shadow is doing or experiencing at this point"
              }
            }
          }
        }
      },
      "required": ["column_headers", "rows"]
    }
  },
  "required": ["analytical_table"]
}
