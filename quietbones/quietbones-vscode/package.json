{
  "name": "quietbones",
  "displayName": "QuietBones",
  "description": "Regenerate sections of QuietBones explorations with AI",
  "version": "0.1.0",
  "publisher": "badjacent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quietbones.regenerate",
        "title": "QuietBones: Regenerate Section"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "quietbones.regenerate",
          "when": "editorHasSelection && resourceExtname == .md",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "QuietBones",
      "properties": {
        "quietbones.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python executable (defaults to .venv/bin/python in the feldenkrais repo)"
        },
        "quietbones.regenScript": {
          "type": "string",
          "default": "",
          "description": "Path to regen.py (auto-detected from workspace)"
        }
      }
    }
  }
}
